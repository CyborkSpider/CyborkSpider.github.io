---
const { label, icon } = Astro.props as { label: string; icon?: string };

const icons: Record<string, string> = {
  html: 'M4 3h16v18l-8 2-8-2V3Zm4 4h8M8 10h8M8 14h6',
  css: 'M4 3h16v18l-8 2-8-2V3Zm5 6h6M9 12h6M9 16h4',
  bootstrap: 'M7 4h7.5a4 4 0 0 1 0 8H7V4Zm0 8h8a4 4 0 0 1 0 8H7v-8Z',
  python: 'M10 3h4a3 3 0 0 1 3 3v3H9V6a3 3 0 0 1 3-3Zm-3 8h8v3a3 3 0 0 1-3 3h-4a3 3 0 0 1-3-3v-3Z',
  django: 'M10 3h4v18h-4V3Zm-4 6h3v12H6V9Zm9 3h3v9h-3v-9Z',
  typescript: 'M4 4h16v16H4V4Zm6 5H7v2h3v7h2v-7h3V9h-5Z',
  javascript: 'M4 4h16v16H4V4Zm8 4v8a3 3 0 0 1-3 3H7v-2h2a1 1 0 0 0 1-1V8h2Zm7 0v8a3 3 0 0 1-3 3h-2v-2h2a1 1 0 0 0 1-1V8h2Z',
  astro: 'M6 19 9.5 5h5L18 19l-4.3-3-1.7-6-1.7 6L6 19Z',
  tailwind: 'M6 10c1.2-3.2 4-4.4 7-3 1.6.8 2.5 2.1 3.2 3.2.9 1.3 1.5 2.3 3.8 2.6-1.2 3.2-4 4.4-7 3-1.6-.8-2.5-2.1-3.2-3.2-.9-1.3-1.5-2.3-3.8-2.6Z',
  photoshop: 'M5 4h14v16H5V4Zm4 4h3.5a2.5 2.5 0 0 1 0 5H9V8Zm0 5h3m4-3v7m-2 0h4',
  bash: 'M5 6h14v12H5V6Zm3 3 3 3-3 3m5 0h3',
  cpp: 'M6 8a6 6 0 0 1 8-2v3a3 3 0 0 0-4 1 3 3 0 0 0 0 4 3 3 0 0 0 4 1v3A6 6 0 0 1 6 8Zm12 3v2m2-2v2',
  sqlite: 'M7 4h10c2 0 3 1 3 2v12c0 1-1 2-3 2H7c-2 0-3-1-3-2V6c0-1 1-2 3-2Zm0 4h10M7 12h10M7 16h10',
  postgres: 'M12 3c4.4 0 7 1.8 7 4v10c0 2.2-2.6 4-7 4s-7-1.8-7-4V7c0-2.2 2.6-4 7-4Zm-5 4c0 1.1 2.2 2 5 2s5-.9 5-2',
  git: 'M9 7 7 9a2 2 0 1 0 1 1l1-1 6 6a2 2 0 1 0 1-1l-6-6 1-1a2 2 0 1 0-3 0Z',
};

const d = icon ? icons[icon] : undefined;
---

<span class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-3 py-2 text-xs font-medium text-zinc-200">
  {d && (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="opacity-90"
    >
      <path d={d} />
    </svg>
  )}
  <span>{label}</span>
</span>
