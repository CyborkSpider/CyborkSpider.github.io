---
const { lang } = Astro.props as { lang: 'ar' | 'en' };
const isAr = lang === 'ar';
const t = {
  name: 'Ziad Elgohary',
  home: isAr ? 'الرئيسية' : 'Home',
  projects: isAr ? 'المشاريع' : 'Projects',
  contact: isAr ? 'تواصل' : 'Contact',
  switchTo: isAr ? 'EN' : 'AR',
};
const homeHref = isAr ? '/ar/' : '/en/';
const projectsHref = isAr ? '/ar/projects/' : '/en/projects/';
const contactHref = isAr ? '/ar/#contact' : '/en/#contact';
const switchHref = isAr ? '/en/' : '/ar/';
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-bg-950/60 backdrop-blur">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4">
    <a href={homeHref} class="text-sm font-semibold tracking-wide text-zinc-100">
      {t.name}
    </a>

    <nav class="flex items-center gap-4 text-sm text-zinc-300">
      <a class="hover:text-zinc-100" href={homeHref}>{t.home}</a>
      <a class="hover:text-zinc-100" href={projectsHref}>{t.projects}</a>
      <a class="hover:text-zinc-100" href={contactHref}>{t.contact}</a>
      <a
        class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3 py-1 text-xs font-semibold text-zinc-100 hover:bg-white/10"
        href={switchHref}
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="m5 8 6 6" />
          <path d="m4 14 6-6 2-3" />
          <path d="M2 5h12" />
          <path d="M7 2h1" />
          <path d="m22 22-5-10-5 10" />
          <path d="M14 18h6" />
        </svg>
        <span class="rounded-full border border-white/10 bg-white/5 px-2 py-0.5">
          {t.switchTo}
        </span>
      </a
      >
    </nav>
  </div>
</header>
