---
import type { Project } from '../data/projects';

const {
  project,
  lang,
} = Astro.props as {
  project: Project;
  lang: 'ar' | 'en';
};

const title = project.title[lang];
const description = project.description[lang];
const isPrivate = project.visibility === 'private';

function getRepoSlug(url: string) {
	const clean = url.replace(/\.git$/i, '').replace(/\/$/, '');
	try {
		const u = new URL(clean);
		const parts = u.pathname.split('/').filter(Boolean);
		if (parts.length >= 2) return `${parts[0]}/${parts[1]}`;
	} catch {
		return null;
	}
	return null;
}

function inferRole(tags: string[]) {
	const t = tags.map((x) => x.toLowerCase());
	const hasCyber = t.some((x) => x.includes('kali') || x.includes('cyber') || x.includes('security'));
	if (hasCyber) {
		return {
			ar: 'الأمن السيبراني',
			en: 'Cybersecurity',
		};
	}

	const hasCpp = t.some((x) => x.includes('c++') || x === 'cpp' || x.includes('cpp'));
	if (hasCpp) {
		return {
			ar: 'Backend Developer',
			en: 'Backend Developer',
		};
	}

	const hasFront = t.some((x) => ['html', 'css', 'bootstrap', 'tailwind', 'tailwindcss', 'astro', 'react', 'next', 'ui', 'template', 'web', 'frontend'].some((k) => x.includes(k)));
	const hasBack = t.some((x) => ['django', 'python', 'backend', 'api', 'multi-tenant', 'postgres', 'postgresql', 'sqlite', 'database'].some((k) => x.includes(k)));

	if (hasFront && hasBack) {
		return {
			ar: 'Full Stack Developer',
			en: 'Full Stack Developer',
		};
	}
	if (hasBack) {
		return {
			ar: 'Backend Developer',
			en: 'Backend Developer',
		};
	}
	return {
		ar: 'Frontend Developer',
		en: 'Frontend Developer',
	};
}

const status = isPrivate ? (lang === 'ar' ? 'Published' : 'Published') : (lang === 'ar' ? 'Draft' : 'Draft');
const role = inferRole(project.tags);
const repoSlug = project.repoUrl ? getRepoSlug(project.repoUrl) : null;
const ogImageUrl = !isPrivate && repoSlug ? `https://opengraph.githubassets.com/1/${repoSlug}` : null;
---

<article class="group overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-[0_0_0_1px_rgba(255,255,255,0.04)_inset] transition hover:bg-white/7">
	{ogImageUrl && (
		<div class="relative">
			<img
				src={ogImageUrl}
				alt={title}
				class="aspect-[16/9] w-full border-b border-white/10 object-cover"
				loading="lazy"
				referrerpolicy="no-referrer"
			/>
			<span class="absolute right-3 top-3 rounded-full border border-emerald-400/25 bg-emerald-400/10 px-3 py-1 text-xs font-semibold text-emerald-200">
				{status}
			</span>
		</div>
	)}

	<div class="p-5">
		<div class="flex items-start justify-between gap-4">
			<div>
				<h3 class="text-lg font-semibold tracking-tight text-zinc-50">{title}</h3>
				<p class="mt-2 text-sm font-medium text-zinc-300">{lang === 'ar' ? `Role: ${role.ar}` : `Role: ${role.en}`}</p>
				<p class="mt-3 text-sm leading-relaxed text-zinc-300">{description}</p>
			</div>

			{!ogImageUrl && (
				<span class:list={[
					'shrink-0 rounded-full px-3 py-1 text-xs font-semibold',
					isPrivate ? 'border border-emerald-400/25 bg-emerald-400/10 text-emerald-200' : 'border border-amber-400/25 bg-amber-400/10 text-amber-200',
				]}>
					{status}
				</span>
			)}
		</div>

		<div class="mt-4 flex flex-wrap gap-2">
			{project.tags.map((tag) => (
				<span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-zinc-300">{tag}</span>
			))}
		</div>

		<div class="mt-5 flex flex-wrap gap-3">
			{!isPrivate && project.demoUrl && (
				<a
					href={project.demoUrl}
					class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100 hover:bg-white/10"
					target="_blank"
					rel="noreferrer"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M2 12h20" /><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z" /></svg>
					{lang === 'ar' ? 'Website' : 'Website'}
				</a>
			)}
			{!isPrivate && project.repoUrl && (
				<a
					href={project.repoUrl}
					class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100 hover:bg-white/10"
					target="_blank"
					rel="noreferrer"
				>
					<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.4 5.4 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" /><path d="M9 18c-4.51 2-5-2-7-2" /></svg>
					{lang === 'ar' ? 'Source' : 'Source'}
				</a>
			)}
		</div>
	</div>
</article>
