---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';

const lang = 'en' as const;
---

<Layout lang={lang} title="Ziad Elgohary | Portfolio">
  <Navbar lang={lang} />
  <main class="mx-auto w-full max-w-5xl px-4 py-12">
    <section class="grid gap-10 md:grid-cols-[1.4fr_0.6fr] md:items-start">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-zinc-50 md:text-4xl">Ziad Elgohary</h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-zinc-300">
          Software developer. This is a concise overview of my work and projects.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="mailto:zelgohary44@gmail.com"
            class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100 hover:bg-white/10"
          >
            zelgohary44@gmail.com
          </a>
          <a
            href="https://github.com/CyborkSpider"
            target="_blank"
            rel="noreferrer"
            class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100 hover:bg-white/10"
          >
            GitHub
          </a>
        </div>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
        <img
          src="/profile.jpg"
          alt="Ziad Elgohary"
          class="aspect-square w-full rounded-xl border border-white/10 bg-white/5 object-cover"
          loading="lazy"
        />
        <p class="mt-4 text-sm text-zinc-300">
          Add your photo at:
          <span class="font-mono text-zinc-100">public/profile.jpg</span>
        </p>
      </div>
    </section>

    <section class="mt-14">
      <div class="flex items-end justify-between gap-6">
        <h2 class="text-xl font-bold text-zinc-50">Featured projects</h2>
        <a class="text-sm font-semibold text-indigo-200 hover:text-indigo-100" href="/en/projects/">View all</a>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {projects.slice(0, 4).map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
    </section>

    <section id="contact" class="mt-16 rounded-2xl border border-white/10 bg-white/5 p-6">
      <h2 class="text-xl font-bold text-zinc-50">Contact</h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-300">
        If you have a project or collaboration opportunity, feel free to reach out.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href="mailto:zelgohary44@gmail.com"
          class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100 hover:bg-white/10"
        >
          Email
        </a>
      </div>
    </section>
  </main>
</Layout>
