---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects';
import SkillPill from '../../components/SkillPill.astro';
import { skillGroups } from '../../data/skills';
import { experiences } from '../../data/experience';
import { education } from '../../data/education';

const lang = 'en' as const;
---

<Layout lang={lang} title="Ziad Elgohary | Full Stack Python Developer (Django)">
  <Navbar lang={lang} />
  <main class="mx-auto w-full max-w-5xl px-4 py-12">
    <section class="grid gap-10 md:grid-cols-[1.4fr_0.6fr] md:items-start">
      <div>
        <h1 class="text-3xl font-bold tracking-tight text-zinc-50 md:text-4xl">Ziad Elgohary</h1>
        <p class="mt-3 max-w-3xl text-sm font-medium text-zinc-300">
          Full Stack Python Developer (Django) · Software Tester · AI Engineering Student
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a
            href="mailto:zelgohary44@gmail.com"
            class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100 hover:bg-white/10"
          >
            zelgohary44@gmail.com
          </a>
          <a
            href="https://github.com/CyborkSpider"
            target="_blank"
            rel="noreferrer"
            class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100 hover:bg-white/10"
          >
            GitHub
          </a>
        </div>
      </div>
      <div class="rounded-2xl border border-white/10 bg-white/5 p-5">
        <img
          src="/profile.jpg"
          alt="Ziad Elgohary"
          class="aspect-square w-full rounded-xl border border-white/10 bg-white/5 object-cover"
          loading="lazy"
        />
      </div>
    </section>

    <section class="mt-14">
      <h2 class="text-xl font-bold text-zinc-50">About</h2>
      <p class="mt-3 max-w-3xl text-sm leading-relaxed text-zinc-300">
        Software developer focused on building fast, clean user experiences with maintainable code.
        This portfolio highlights both public projects and private case studies.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="text-xl font-bold text-zinc-50">Skills</h2>
      <div class="mt-5 grid gap-4">
        {skillGroups.map((group) => (
          <section class="rounded-2xl border border-white/10 bg-white/5 p-5">
            <h3 class="text-sm font-semibold text-zinc-100">{group.title.en}</h3>
            <div class="mt-4 flex flex-wrap gap-2">
              {group.skills.map((s) => (
                <SkillPill label={s.label} icon={s.icon} />
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>

    <section class="mt-14">
      <div class="flex items-end justify-between gap-6">
        <h2 class="text-xl font-bold text-zinc-50">Featured projects</h2>
        <a class="text-sm font-semibold text-indigo-200 hover:text-indigo-100" href="/en/projects/">View all</a>
      </div>
      <div class="mt-6 grid gap-4 md:grid-cols-2">
        {projects.slice(0, 4).map((p) => <ProjectCard project={p} lang={lang} />)}
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-xl font-bold text-zinc-50">Experience</h2>
      <div class="mt-5 grid gap-4">
        {experiences.map((e) => (
          <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-base font-semibold text-zinc-100">{e.title.en}</h3>
                <p class="mt-1 text-sm font-medium text-zinc-300">{e.company}</p>
                <p class="mt-2 text-sm text-zinc-300">{e.summary.en}</p>
              </div>
              <div class="text-right text-xs font-medium text-zinc-300">
                <div>{e.start} — {e.end.en}</div>
                {e.location && <div class="mt-1 text-zinc-400">{e.location.en}</div>}
              </div>
            </div>
            {e.tags?.length ? (
              <div class="mt-4 flex flex-wrap gap-2">
                {e.tags.map((t) => (
                  <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-zinc-300">{t}</span>
                ))}
              </div>
            ) : null}
          </article>
        ))}
      </div>
    </section>

    <section class="mt-16">
      <h2 class="text-xl font-bold text-zinc-50">Education</h2>
      <div class="mt-5 grid gap-4">
        {education.map((ed) => (
          <article class="rounded-2xl border border-white/10 bg-white/5 p-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="text-base font-semibold text-zinc-100">{ed.school}</h3>
                <p class="mt-1 text-sm font-medium text-zinc-300">{ed.degree.en} · {ed.field.en}</p>
                <p class="mt-2 text-sm text-zinc-300">{ed.status.en}</p>
              </div>
              <div class="text-right text-xs font-medium text-zinc-300">
                {ed.start} — {ed.end}
              </div>
            </div>
            {ed.tags?.length ? (
              <div class="mt-4 flex flex-wrap gap-2">
                {ed.tags.map((t) => (
                  <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-zinc-300">{t}</span>
                ))}
              </div>
            ) : null}
          </article>
        ))}
      </div>
    </section>

    <section id="contact" class="mt-16 rounded-2xl border border-white/10 bg-white/5 p-6">
      <h2 class="text-xl font-bold text-zinc-50">Contact</h2>
      <p class="mt-3 text-sm leading-relaxed text-zinc-300">
        If you have a project or collaboration opportunity, feel free to reach out.
      </p>
      <div class="mt-5 flex flex-wrap gap-3">
        <a
          href="mailto:zelgohary44@gmail.com"
          class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100 hover:bg-white/10"
        >
          <span class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m22 7-8.99 5.7a2 2 0 0 1-2.02 0L2 7" /><rect width="20" height="16" x="2" y="4" rx="2" /></svg>
            Email
          </span>
        </a>
        <a
          href="https://www.linkedin.com/in/ziad-elgohary4/"
          target="_blank"
          rel="noreferrer"
          class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100 hover:bg-white/10"
        >
          <span class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6Z" /><rect width="4" height="12" x="2" y="9" /><circle cx="4" cy="4" r="2" /></svg>
            LinkedIn
          </span>
        </a>
        <a
          href="https://wa.me/201028335151"
          target="_blank"
          rel="noreferrer"
          class="rounded-full border border-white/15 bg-white/5 px-4 py-2 text-sm font-semibold text-zinc-100 hover:bg-white/10"
        >
          <span class="inline-flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8.5 8.5 0 0 1-12.7 7.4L3 21l1.6-5.3A8.5 8.5 0 1 1 21 12Z" /><path d="M8.5 10.5c.2 1 .8 2 1.6 2.8.8.8 1.8 1.4 2.8 1.6.4.1.8 0 1.1-.2l1.2-.7c.3-.2.7-.1.9.2l.9 1.3c.2.3.1.7-.1.9l-1 1c-.3.3-.7.4-1.1.4-2.2 0-4.9-1.7-6.7-3.5S6.2 11.9 6.2 9.7c0-.4.1-.8.4-1.1l1-1c.2-.2.6-.3.9-.1l1.3.9c.3.2.4.6.2.9l-.7 1.2c-.2.3-.3.7-.2 1.1Z" /></svg>
            WhatsApp
          </span>
        </a>
      </div>
    </section>
  </main>
</Layout>
