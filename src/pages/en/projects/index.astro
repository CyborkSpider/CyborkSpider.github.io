---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { projects } from '../../../data/projects';

const lang = 'en' as const;
---

<Layout lang={lang} title="Ziad Elgohary | Projects">
  <Navbar lang={lang} />
  <main class="mx-auto w-full max-w-5xl px-4 py-12">
    <header class="flex flex-col gap-3">
      <div class="inline-flex w-fit rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold text-zinc-100">
        My Projects
      </div>
      <h1 class="text-3xl font-bold tracking-tight text-zinc-50 md:text-4xl">Check out my latest work</h1>
      <p class="max-w-3xl text-sm leading-relaxed text-zinc-300">
        I’ve worked on a variety of projects. Private projects are displayed as case studies without exposing source code.
      </p>
    </header>

    <section class="mt-8 grid gap-4 md:grid-cols-2">
      {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
    </section>
  </main>
</Layout>
