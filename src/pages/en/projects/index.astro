---
import Layout from '../../../layouts/Layout.astro';
import Navbar from '../../../components/Navbar.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { projects } from '../../../data/projects';

const lang = 'en' as const;
---

<Layout lang={lang} title="Ziad Elgohary | Projects">
  <Navbar lang={lang} />
  <main class="mx-auto w-full max-w-5xl px-4 py-12">
    <header class="flex flex-col gap-3">
      <h1 class="text-2xl font-bold text-zinc-50">Projects</h1>
      <p class="text-sm leading-relaxed text-zinc-300">
        A list of projects (public/private). Private projects are displayed as case studies without exposing source code.
      </p>
    </header>

    <section class="mt-8 grid gap-4 md:grid-cols-2">
      {projects.map((p) => <ProjectCard project={p} lang={lang} />)}
    </section>
  </main>
</Layout>
